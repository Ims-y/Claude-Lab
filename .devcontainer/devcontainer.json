{
    "name": "Claude-Code-Sandbox",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
    "postCreateCommand": "npm install -g @anthropic-ai/claude-code",
    "mounts": [
        "source=/Users/ims/Documents/Brain,target=/home/node/Brain,type=bind",
        "source=${localEnv:HOME}/Obsidian,target=/home/node/Obsidian,type=bind,consistency=cached"
    ]
}